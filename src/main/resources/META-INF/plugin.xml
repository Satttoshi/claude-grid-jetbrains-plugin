<idea-plugin>
    <id>io.github.satttoshi.claudegrid</id>
    <name>Grid for Claude Code</name>
    <vendor url="https://github.com/Satttoshi/claude-grid-jetbrains-plugin">Joshua Stolle</vendor>
    <description><![CDATA[
        <p>Run several <a href="https://docs.claude.com/en/docs/claude-code">Claude Code</a> sessions side by side
        in a <b>Claude Grid</b> sidebar tool window, using the IDE's own terminal.</p>
        <ul>
          <li>Automatic tiling: one session fills the view, two or three sit in columns, four or more form a grid.
              Switch between Columns, Rows and Grid without restarting sessions.</li>
          <li>Resizable panes, maximize/restore a pane, keyboard shortcuts to move between panes.</li>
          <li>Panes are named after Claude's conversation title; double-click a name to rename it.</li>
          <li>Sessions, layout and pane sizes are restored after an IDE restart, and every pane resumes its own conversation.</li>
          <li>Reopen recently closed sessions, or resume any conversation through Claude's picker.</li>
        </ul>
        <p>Requires the <code>claude</code> CLI on your <code>PATH</code>.</p>
        <p><i>Community plugin, not affiliated with or endorsed by Anthropic. Claude is a trademark of Anthropic.</i></p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Claude Grid" anchor="right" icon="/icons/claudeGrid.svg"
                    factoryClass="dev.claudegrid.ui.ClaudeGridToolWindowFactory"
                    doNotActivateOnStart="true"/>
        <notificationGroup id="Claude Grid" displayType="BALLOON"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <allowedActionsProvider implementation="dev.claudegrid.compat.ClaudeGridTerminalAllowedActions"/>
    </extensions>

    <actions>
        <action id="ClaudeGrid.OpenGrid" class="dev.claudegrid.actions.OpenGridAction"
                text="Open Claude Grid" description="Show all Claude Code sessions side by side"
                icon="/icons/claudeGrid.svg">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift C"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="ClaudeGrid.NewSession" class="dev.claudegrid.actions.NewSessionAction"
                text="New Claude Session" description="Start a shell in the project root and run claude"
                icon="AllIcons.General.Add">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift N"/>
        </action>
        <action id="ClaudeGrid.CloseSession" class="dev.claudegrid.actions.CloseSessionAction"
                text="Close Claude Session" description="Terminate the focused Claude session"
                icon="AllIcons.Actions.Cancel"/>
        <action id="ClaudeGrid.ToggleMaximize" class="dev.claudegrid.actions.ToggleMaximizeAction"
                text="Maximize / Restore Pane" description="Toggle the focused pane to fill the grid"
                icon="AllIcons.General.ExpandComponent">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift M"/>
        </action>
        <action id="ClaudeGrid.FocusNext" class="dev.claudegrid.actions.FocusNextAction"
                text="Focus Next Claude Pane" icon="AllIcons.Actions.Forward">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift CLOSE_BRACKET"/>
        </action>
        <action id="ClaudeGrid.FocusPrevious" class="dev.claudegrid.actions.FocusPreviousAction"
                text="Focus Previous Claude Pane" icon="AllIcons.Actions.Back">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift OPEN_BRACKET"/>
        </action>

        <action id="ClaudeGrid.ReopenClosed" class="dev.claudegrid.actions.ReopenClosedSessionAction"
                text="Reopen Closed Claude Session" description="Resume the most recently closed Claude session"
                icon="AllIcons.Vcs.History">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift T"/>
        </action>
        <action id="ClaudeGrid.ResumeWithPicker" class="dev.claudegrid.actions.ResumeWithClaudePickerAction"
                text="Resume with Claude's Picker…"
                description="Open a pane running 'claude --resume' to pick any conversation"
                icon="AllIcons.Actions.Search"/>
        <action id="ClaudeGrid.ClearRecentlyClosed" class="dev.claudegrid.actions.ClearRecentlyClosedAction"
                text="Clear Recently Closed"
                description="Forget the recently closed list (Claude's conversations are kept)"/>
        <group id="ClaudeGrid.ResumeMenu" class="dev.claudegrid.actions.ResumeSessionGroup" popup="true"
               text="Resume Session" description="Resume a recently closed Claude session"
               icon="AllIcons.Vcs.History"/>

        <group id="ClaudeGrid.Layout" text="Layout" popup="true" icon="AllIcons.Actions.Layout">
            <action id="ClaudeGrid.Layout.Columns" class="dev.claudegrid.actions.LayoutColumnsAction"
                    text="Columns" icon="AllIcons.Actions.SplitVertically"/>
            <action id="ClaudeGrid.Layout.Rows" class="dev.claudegrid.actions.LayoutRowsAction"
                    text="Rows" icon="AllIcons.Actions.SplitHorizontally"/>
            <action id="ClaudeGrid.Layout.Grid" class="dev.claudegrid.actions.LayoutGridAction"
                    text="Grid" icon="AllIcons.Actions.GroupByModule"/>
        </group>

        <group id="ClaudeGrid.Toolbar">
            <reference ref="ClaudeGrid.NewSession"/>
            <reference ref="ClaudeGrid.ResumeMenu"/>
            <reference ref="ClaudeGrid.CloseSession"/>
            <separator/>
            <reference ref="ClaudeGrid.Layout.Columns"/>
            <reference ref="ClaudeGrid.Layout.Rows"/>
            <reference ref="ClaudeGrid.Layout.Grid"/>
            <separator/>
            <reference ref="ClaudeGrid.ToggleMaximize"/>
            <reference ref="ClaudeGrid.FocusPrevious"/>
            <reference ref="ClaudeGrid.FocusNext"/>
        </group>
    </actions>
</idea-plugin>
